<div class="product-card">

  <% if product.image_url.present? %>
    <%= image_tag product.image_url,
                  alt: product.title,
                  class: "book-cover" %>
  <% end %>

  <h3>
    <%= link_to product.title, product %>
  </h3>

  <p>
    <strong>Author:</strong>
    <%= product.author %>
  </p>

  <p class="price">
    $<%= product.price %>
  </p>

  <p>
    <%= link_to "View Details", product, class: "details-btn" %>
  </p>

</div>