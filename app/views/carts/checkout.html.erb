<h1>Checkout</h1>
<div class="checkout-container">

<p>Customer Information</p>

<%= form_with url: place_order_cart_path, method: :post do %>
  <p>
    Address<br>
    <%= text_field_tag :address %>
  </p>

  <p>
    Province<br>
    <%= select_tag :province_id,
    options_from_collection_for_select(
      Province.all.order(:name),
      :id,
      :name
    ) %>
  </p>

  <%= submit_tag "Place Order" %>

<% end %>

<hr>

<h3>Or pay securely with Stripe</h3>

<%= button_to "Pay with Stripe",
              create_checkout_session_cart_path,
              method: :post,
              class: "details-btn",
              form: { data: { turbo: false } } %>

<hr>

<h2>Invoice</h2>

<% @items.each do |product| %>

  <div class="invoice-item">
  <strong><%= product.title %></strong><br>

  Quantity:
  <%= @cart[product.id.to_s] %><br>

  Price:
  $<%= product.price %>
</div>

<% end %>

<hr>

<p><strong>Subtotal:</strong> $<%= @subtotal.round(2) %></p>

<p><strong>GST:</strong> $<%= @gst.round(2) %></p>

<p><strong>PST/HST:</strong> $<%= @pst.round(2) %></p>

<h3>Total: $<%= @total.round(2) %></h3>

</div>