<h1>Shopping Cart</h1>

<% if @items.any? %>

  <%= render partial: "cart_item",
             collection: @items,
             as: :product,
             locals: { cart: @cart } %>

<% else %>

  <p>Your cart is empty.</p>

<% end %>

<%= link_to "Continue Shopping", products_path %>

<br><br>

<%= button_to "Checkout", checkout_cart_path, method: :get %>