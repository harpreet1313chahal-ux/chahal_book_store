<h1>Edit Tax Rates</h1>

<%= form_with model: @province do |f| %>

  <p>
    <%= f.label :gst %><br>
    <%= f.number_field :gst, step: 0.0001 %>
  </p>

  <p>
    <%= f.label :pst %><br>
    <%= f.number_field :pst, step: 0.0001 %>
  </p>

  <p>
    <%= f.label :hst %><br>
    <%= f.number_field :hst, step: 0.0001 %>
  </p>

  <%= f.submit "Save" %>

<% end %>