<div class="order-card">

  <h2>Order #<%= order.id %></h2>

  <p>
    <strong>Date:</strong>
    <%= order.created_at.strftime("%B %d, %Y") %>
  </p>

  <p>
    <strong>Status:</strong>
    <%= order.status %>
  </p>

  <p>
    <strong>Total:</strong>
    $<%= order.total_price %>
  </p>

  <h3>Products</h3>

  <ul>
    <% order.order_items.each do |item| %>
      <li>
        <%= item.product.title %>
        (Qty: <%= item.quantity %>)
      </li>
    <% end %>
  </ul>

  <%= link_to "View Order", order_path(order) %>

</div>