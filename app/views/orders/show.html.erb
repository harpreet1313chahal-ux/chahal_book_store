<h1>Order #<%= @order.id %></h1>

<p><strong>Date:</strong> <%= @order.created_at.strftime("%B %d, %Y") %></p>

<p><strong>GST Rate:</strong> <%= (@order.gst_rate * 100).round(2) %>%</p>
<p><strong>PST Rate:</strong> <%= (@order.pst_rate * 100).round(2) %>%</p>
<p><strong>HST Rate:</strong> <%= (@order.hst_rate * 100).round(2) %>%</p>

<p><strong>Tax:</strong> $<%= @order.tax_amount %></p>
<p><strong>Total:</strong> $<%= @order.total_price %></p>

<h2>Products</h2>

<% @order.order_items.each do |item| %>
  <div class="product-card">
    <h3><%= item.product.title %></h3>
    <p>Quantity: <%= item.quantity %></p>
    <p>Unit Price: $<%= item.unit_price %></p>
    <p>Subtotal: $<%= item.subtotal %></p>
  </div>
<% end %>

<p><%= link_to "Back to Orders", orders_path %></p>