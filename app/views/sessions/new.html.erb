<h1>Login</h1>

<%= form_with url: login_path, local: true do %>

  <p>
    <label>Email</label><br>
    <%= email_field_tag :email %>
  </p>

  <p>
    <label>Password</label><br>
    <%= password_field_tag :password %>
  </p>

  <p>
    <%= submit_tag "Login" %>
  </p>

<% end %>

<p>
  <%= link_to "Create an Account", new_user_path %>
</p>